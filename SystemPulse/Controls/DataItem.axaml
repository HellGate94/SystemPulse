<ResourceDictionary xmlns="https://github.com/avaloniaui"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:controls="using:SystemPulse.Controls">

	<Design.PreviewWith>
		<StackPanel Width="142" Spacing="10" Margin="20">
			<controls:DataItem Label="RAM" Value="65" ValueFormat="{}{0:0}%" LabelValue="11.2 GB" LabelValueToolTip="Available memory" />
			<controls:DataItem Label="Down" Value="35" LabelValue="12.4 MB/s" />
		</StackPanel>
	</Design.PreviewWith>

	<ControlTheme x:Key="{x:Type controls:DataItem}" TargetType="controls:DataItem">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Template">
			<ControlTemplate>
				<StackPanel Background="{TemplateBinding Background}">
					<Grid Classes="MetricRow" ColumnDefinitions="*,Auto">
						<StackPanel Orientation="Horizontal" Spacing="4">
							<ContentPresenter Content="{TemplateBinding Icon}"
											  IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
							<TextBlock Classes="MetricLabel"
									   Text="{TemplateBinding Label}"
									   IsVisible="{TemplateBinding Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
						</StackPanel>
						<StackPanel Grid.Column="1"
									Orientation="Horizontal"
									Spacing="4"
									VerticalAlignment="Center"
									Background="Transparent"
									IsVisible="{TemplateBinding LabelValue, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
									ToolTip.Tip="{TemplateBinding LabelValueToolTip}">
							<ContentPresenter Content="{TemplateBinding SecondaryIcon}"
											  VerticalAlignment="Center"
											  IsVisible="{TemplateBinding SecondaryIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />
							<TextBlock Classes="MetricSecondary"
									   Text="{TemplateBinding LabelValue}" />
						</StackPanel>
					</Grid>
					<Panel>
						<ProgressBar Classes="Load"
									 Minimum="{TemplateBinding Minimum}"
									 Maximum="{TemplateBinding Maximum}"
									 Value="{TemplateBinding Value}"
									 Classes.isWarning="{TemplateBinding IsWarning}"
									 controls:ToolTipHelper.Tip="{TemplateBinding ProgressToolTip}" />
						<TextBlock Classes="BarOverlayText"
								   Text="{TemplateBinding ProgressValue}"
								   IsVisible="{TemplateBinding ProgressValue, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
								   IsHitTestVisible="False" />
					</Panel>
				</StackPanel>
			</ControlTemplate>
		</Setter>
	</ControlTheme>
</ResourceDictionary>