<Styles xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:views="using:SystemPulse.Views">
	<Design.PreviewWith>
		<views:MainWindow />
	</Design.PreviewWith>

	<Style Selector="StackPanel.PanelRoot">
		<Setter Property="Margin" Value="8,100,8,16" />
		<Setter Property="Spacing" Value="0" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
	</Style>

	<Style Selector="StackPanel.ClockHero">
		<Setter Property="Spacing" Value="3" />
		<Setter Property="Margin" Value="0,0,0,2" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
	</Style>
	<Style Selector="TextBlock.Clock">
		<Setter Property="FontSize" Value="26" />
		<Setter Property="FontWeight" Value="Medium" />
		<Setter Property="FontFeatures" Value="+tnum" />
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="Foreground" Value="{DynamicResource SystemBaseHighColor}" />
	</Style>
	<Style Selector="TextBlock.DateLine">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}" />
	</Style>

	<Style Selector="StackPanel.CategoryList">
		<Setter Property="Margin" Value="0" />
		<Setter Property="Spacing" Value="8" />
	</Style>
	<Style Selector="Grid.Header">
		<Setter Property="Margin" Value="0,24,0,12" />
		<Style Selector="^ PathIcon">
			<Setter Property="Width" Value="18" />
			<Setter Property="Height" Value="18" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Foreground" Value="{DynamicResource SystemBaseHighColor}" />
		</Style>
		<Style Selector="^ TextBlock">
			<Setter Property="FontSize" Value="16" />
			<Setter Property="FontWeight" Value="Medium" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Foreground" Value="{DynamicResource SystemBaseHighColor}" />
		</Style>
		<Style Selector="^ Border.HeaderLine">
			<Setter Property="Height" Value="1" />
			<Setter Property="Margin" Value="6,1,0,0" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Background" Value="{DynamicResource SystemBaseLowColor}" />
		</Style>
	</Style>

	<Style Selector="Grid.MetricRow">
		<Setter Property="Margin" Value="0,0,0,3" />
	</Style>
	<Style Selector="TextBlock.MetricLabel">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}" />
		<Setter Property="TextTrimming" Value="CharacterEllipsis" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>
	<Style Selector="TextBlock.MetricSecondary">
		<Setter Property="FontSize" Value="11.5" />
		<Setter Property="FontFeatures" Value="+tnum" />
		<Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>
	<Style Selector="PathIcon.FreeSpaceGlyph, PathIcon.MetricGlyph">
		<Setter Property="Width" Value="10" />
		<Setter Property="Height" Value="10" />
		<Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}" />
	</Style>
	<Style Selector="PathIcon.WarningGlyph">
		<Setter Property="Width" Value="11" />
		<Setter Property="Height" Value="11" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Foreground" Value="#EF4444" />
	</Style>
	<Style Selector="TextBlock.BarOverlayText">
		<Setter Property="FontSize" Value="11" />
		<Setter Property="Margin" Value="0,1,0,0" />
		<Setter Property="FontWeight" Value="Medium" />
		<Setter Property="FontFeatures" Value="+tnum" />
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Foreground" Value="{DynamicResource SystemBaseHighColor}" />
	</Style>

	<Style Selector="ItemsControl.CoreGrid">
		<Setter Property="Margin" Value="0,2,0,0" />
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="UseLayoutRounding" Value="False" />
	</Style>
	<Style Selector="Border.CoreGroup">
		<Setter Property="Padding" Value="2" />
		<Setter Property="BorderBrush" Value="{DynamicResource SystemBaseLowColor}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="3" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="HorizontalAlignment" Value="Center" />
	</Style>

	<Style Selector="ProgressBar.Load">
		<Setter Property="Theme" Value="{StaticResource {x:Type ProgressBar}}" />
		<Setter Property="Height" Value="16" />
		<Setter Property="MinHeight" Value="0" />
		<Setter Property="MinWidth" Value="0" />
		<Setter Property="Foreground">
			<Setter.Value>
				<SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.6" />
			</Setter.Value>
		</Setter>
		<Setter Property="Background">
			<Setter.Value>
				<SolidColorBrush Color="{DynamicResource SystemBaseLowColor}" />
			</Setter.Value>
		</Setter>
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="CornerRadius" Value="3" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Style Selector="^ /template/ Border#ProgressBarRoot">
			<Setter Property="Background">
				<Setter.Value>
					<SolidColorBrush Color="{DynamicResource SystemBaseLowColor}" />
				</Setter.Value>
			</Setter>
		</Style>
		<Style Selector="^ /template/ Border#PART_Indicator">
			<Setter Property="CornerRadius" Value="3" />
		</Style>
	</Style>
	<Style Selector="ProgressBar.Load.CoreLoad">
		<Setter Property="Width" Value="10" />
		<Setter Property="Height" Value="26" />
		<Setter Property="Orientation" Value="Vertical" />
		<Setter Property="Margin" Value="0" />
		<Setter Property="CornerRadius" Value="2.5" />
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="Foreground">
			<Setter.Value>
				<SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.82" />
			</Setter.Value>
		</Setter>
		<Style Selector="^ /template/ Border#PART_Indicator">
			<Setter Property="CornerRadius" Value="2.5" />
		</Style>
	</Style>
	<Style Selector="ProgressBar.Load.isWarning">
		<Setter Property="Foreground" Value="#CCEF4444" />
		<Style Selector="^ /template/ Border#ProgressBarRoot">
			<Setter Property="Background" Value="#2AEF4444" />
		</Style>
	</Style>

	<Style Selector="StackPanel.InfoTip">
		<Setter Property="Spacing" Value="4" />
		<Setter Property="MinWidth" Value="140" />
	</Style>
	<Style Selector="TextBlock.InfoTipTitle">
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="Margin" Value="0,0,0,2" />
	</Style>
	<Style Selector="TextBlock.InfoTipSubTitle">
		<Setter Property="FontSize" Value="11.5" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}" />
		<Setter Property="Margin" Value="0,0,0,2" />
	</Style>
	<Style Selector="Grid.InfoTipGrid">
		<Setter Property="Margin" Value="0" />
	</Style>
	<Style Selector="TextBlock.InfoTipLabel">
		<Setter Property="FontSize" Value="11.5" />
		<Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}" />
		<Setter Property="Margin" Value="0,0,12,0" />
	</Style>
	<Style Selector="TextBlock.InfoTipValue">
		<Setter Property="FontSize" Value="11.5" />
		<Setter Property="FontWeight" Value="Medium" />
		<Setter Property="FontFeatures" Value="+tnum" />
		<Setter Property="HorizontalAlignment" Value="Right" />
	</Style>
	<Style Selector="TextBlock.InfoTipValue.isWarning">
		<Setter Property="Foreground" Value="#EF4444" />
	</Style>

	<Style Selector="TextBlock.IpLabel">
		<Setter Property="Margin" Value="0,0,0,2" />
	</Style>
	<Style Selector="TextBlock.IpValue">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="HorizontalAlignment" Value="Right" />
	</Style>
	<Style Selector="TextBlock.Censor">
		<Setter Property="Padding" Value="6,2" />
		<Setter Property="Margin" Value="-6,-2" />
		<Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}" />
		<Setter Property="Effect">
			<Setter.Value>
				<BlurEffect Radius="8" />
			</Setter.Value>
		</Setter>
		<Style Selector="^:pointerover">
			<Setter Property="Effect" Value="{x:Null}" />
		</Style>
	</Style>

	<Style Selector="StackPanel.DriveItemsPanel">
		<Setter Property="Spacing" Value="8" />
	</Style>
	<Style Selector="StackPanel.DriveItem">
		<Setter Property="Spacing" Value="3" />
	</Style>
	<Style Selector="ItemsControl.DriveList">
		<Setter Property="HorizontalAlignment" Value="Stretch" />
	</Style>
	<Style Selector="PathIcon.NetworkArrow">
		<Setter Property="Width" Value="12" />
		<Setter Property="Height" Value="12" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}" />
	</Style>

	<!-- Settings -->
	<Style Selector="StackPanel.SettingsRoot">
		<Setter Property="Margin" Value="16" />
		<Setter Property="Spacing" Value="12" />
	</Style>
	<Style Selector="Grid.SettingsHeader">
		<Setter Property="Margin" Value="0,4,0,0" />
		<Style Selector="^ TextBlock">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="FontWeight" Value="Medium" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Foreground" Value="{DynamicResource SystemBaseHighColor}" />
		</Style>
		<Style Selector="^ Border.HeaderLine">
			<Setter Property="Height" Value="1" />
			<Setter Property="Margin" Value="8,1,0,0" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Background" Value="{DynamicResource SystemBaseLowColor}" />
		</Style>
	</Style>
	<Style Selector="TextBlock.FieldLabel">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="Margin" Value="0,0,0,4" />
		<Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}" />
	</Style>
</Styles>